# Local dev/test container — not used in production (see Dockerfile for that).
# Provides PHP 8.4 CLI + Composer + the extensions needed to run
# composer install / vendor/bin/pest / vendor/bin/pint against the
# bind-mounted source tree, PLUS Node/npm so `npm run dev`/`npm run build`
# can run in the same container — the Wayfinder Vite plugin shells out to
# `php artisan wayfinder:generate` during both, so npm needs PHP on its PATH
# too. Running both toolchains in one container avoids needing a `php` shim
# on the host.
FROM php:8.4-cli-alpine

RUN apk add --no-cache \
    git \
    unzip \
    icu-dev \
    libzip-dev \
    sqlite-dev \
    nodejs \
    npm \
    $PHPIZE_DEPS \
    && docker-php-ext-install intl zip pdo_sqlite bcmath \
    && apk del $PHPIZE_DEPS

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html
